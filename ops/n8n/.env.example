# Copy to .env and fill before `docker compose up -d`
# Jack solo operator — Community self-host (internal use)

N8N_HOST=localhost
N8N_HOST_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/

# Asia/Tokyo (user zone)
GENERIC_TIMEZONE=Asia/Tokyo
TZ=Asia/Tokyo

# REQUIRED — long random string (≥32 chars). Persist forever; losing it
# bricks encrypted credentials in the n8n_data volume.
# Generate: openssl rand -hex 32
N8N_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Optional — JWT secret for user management (also use a long random string)
N8N_USER_MANAGEMENT_JWT_SECRET=

# Do NOT put Slack tokens or skill secrets here for the spike.
# HM-PF-53 owns notify bridge; HTTP stubs stay placeholder URLs.
